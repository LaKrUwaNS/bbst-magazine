# ==============================================================================
# BBST MAGAZINE ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# For local Docker: postgresql://bbst_user:bbst_password@localhost:5432/bbst_magazine?schema=public
# For Vercel Production (Neon / Supabase):
# - DATABASE_URL: Pooled connection string (for serverless queries)
# - DIRECT_URL: Direct unpooled connection string (for migrations)
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require"

# Docker Compose only (ignore when deploying to Vercel)
POSTGRES_USER=bbst_user
POSTGRES_PASSWORD=bbst_password
POSTGRES_DB=bbst_magazine
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# ------------------------------------------------------------------------------
# 2. APPLICATION URL & BETTER AUTH
# ------------------------------------------------------------------------------
# Local: http://localhost:3000
# Vercel: https://your-project.vercel.app (or custom domain)
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"
BETTER_AUTH_URL="https://your-project.vercel.app"

# Generate a high-entropy 32+ char secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET="your-secure-random-better-auth-secret-min-32-chars"
AUTH_SECRET="your-secure-random-admin-auth-secret-min-32-chars"

# ------------------------------------------------------------------------------
# 3. CLOUDINARY (Persistent Storage for PDF Magazines & Image Uploads)
# ------------------------------------------------------------------------------
# Cloudinary credentials from https://cloudinary.com/console
# Vercel uses serverless functions where local disk storage is ephemeral.
# Cloudinary is REQUIRED for persistent file uploads in production.
CLOUDINARY_CLOUD_NAME="YOUR_CLOUD_NAME"
CLOUDINARY_API_KEY="YOUR_API_KEY"
CLOUDINARY_API_SECRET="YOUR_API_SECRET"

# ------------------------------------------------------------------------------
# 4. ADMIN / EDITOR CREDENTIALS
# ------------------------------------------------------------------------------
# Default username for admin editorial login (/admin/login)
EDITOR_USERNAME="editor@bbst.uwu.ac.lk"

# Generated hash for editor password
# Generate using: `npm run hash-password <YOUR_CHOSEN_PASSWORD>`
EDITOR_PASSWORD_HASH="salt_hex:derived_key_hex"

# ------------------------------------------------------------------------------
# 5. EMAIL & GMAIL SMTP CONFIGURATION (Nodemailer)
# ------------------------------------------------------------------------------
# For Gmail SMTP:
# 1. Enable 2-Step Verification in your Google Account.
# 2. Go to Security -> 2-Step Verification -> App Passwords.
# 3. Create an App Password for 'Mail' / 'BBST Magazine'.
# 4. Paste the 16-character generated password into SMTP_PASSWORD.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="ceylonnest.org@gmail.com"
SMTP_PASSWORD="your_16_character_gmail_app_password"
EMAIL_FROM_NAME="BBST Magazine"
EMAIL_FROM="ceylonnest.org@gmail.com"
EDITOR_NOTIFICATION_EMAIL="ceylonnest.org@gmail.com"




