generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  role          String? // ADMIN, EDITOR, or null
  sessions      Session[]
  accounts      Account[]

  // Custom relations
  articles  Article[]
  auditLogs AuditLog[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  iconName    String?
  coverImage  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]

  @@map("category")
}

model MagazineIssue {
  id                 String    @id @default(uuid())
  title              String
  slug               String    @unique
  edition            String?
  description        String?
  coverImage         String?
  coverImagePublicId String?
  pdfAsset           String?
  pdfAssetPublicId   String?
  publicationDate    DateTime?
  publicationYear    Int?
  isFeatured         Boolean   @default(false)
  status             String    @default("draft") // draft, published, archived
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("magazine_issue")
}

model Article {
  id                 String    @id @default(uuid())
  title              String
  slug               String    @unique
  excerpt            String?
  content            String? // rich-text HTML
  coverImage         String?
  coverImagePublicId String?
  status             String    @default("DRAFT") // SUBMITTED, UNDER_REVIEW, REVISION_REQUESTED, APPROVED, PUBLISHED, REJECTED, DRAFT
  tags               String?   // comma-separated tags
  isFeatured         Boolean   @default(false)

  // Contributor & Attribution metadata
  authorName         String?
  authorEmail        String?
  authorDept         String?
  enteredByEditor    Boolean   @default(false)
  submissionSource   String?   // "Web Submission", "Email", "Word Document", "Direct"
  submissionRef      String?   @unique

  // Editorial Review & Feedback
  editorialFeedback  String?
  rejectionReason    String?
  editorialNotes     String?
  reviewedBy         String?
  submittedAt        DateTime?
  reviewedAt         DateTime?
  publishedAt        DateTime?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  authorId           String?
  author             User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  writerId           String?
  writer             WriterProfile? @relation(fields: [writerId], references: [id], onDelete: SetNull)

  categoryId         String?
  category           Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  revisions          ArticleRevision[]

  @@map("article")
}

model WriterProfile {
  id                   String    @id @default(uuid())
  name                 String
  slug                 String    @unique
  bio                  String?
  shortBio             String?
  profileImageUrl      String?
  profileImagePublicId String?
  department           String?
  academicYear         String?
  role                 String?
  expertise            String?
  email                String?
  website              String?
  socialLinks          Json?
  status               String    @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  isFeatured           Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  articles             Article[]

  @@map("writer_profile")
}

model ArticleRevision {
  id          String   @id @default(uuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  title       String
  excerpt     String?
  content     String?
  coverImage  String?
  feedback    String?
  status      String
  createdById String? // e.g. "editor" or "writer"
  createdAt   DateTime @default(now())

  @@map("article_revision")
}

model EditorialActivity {
  id          String   @id @default(uuid())
  action      String   // e.g. "ARTICLE_SUBMITTED", "ARTICLE_PUBLISHED", "REVISION_REQUESTED", "MAGAZINE_CREATED", etc.
  entityType  String   // "ARTICLE", "MAGAZINE", "CATEGORY"
  entityId    String
  entityTitle String?
  performedBy String   // editor email or "writer"
  details     String?
  createdAt   DateTime @default(now())

  @@map("editorial_activity")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  details   String?
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_log")
}

model NotificationLog {
  id          String   @id @default(uuid())
  recipient   String
  type        String   // SUBMISSION_CONFIRMATION, SUBMISSION_EDITOR_ALERT, STATUS_UPDATE, CONTACT_MESSAGE, PASSWORD_RESET, MAGAZINE_ALERT, SYSTEM_TEST
  subject     String
  status      String   // SENT, FAILED, SIMULATED
  error       String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@map("notification_log")
}


